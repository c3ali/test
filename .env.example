# Configuration de la plateforme de génération de code

# === API LLM (OBLIGATOIRE) ===
GEMINI_API_KEY=your_gemini_api_key_here

# === Déploiement automatique (OPTIONNEL) ===

# Railway - Pour déployer automatiquement sur Railway
# Obtenez votre token sur: https://railway.app/account/tokens
RAILWAY_TOKEN=your_railway_token_here

# Supabase - Pour créer automatiquement les bases de données
# Obtenez votre token sur: https://app.supabase.com/account/tokens
SUPABASE_ACCESS_TOKEN=your_supabase_access_token_here

# === GitHub (OPTIONNEL) ===
# Pour pousser automatiquement le code sur GitHub
GITHUB_ACCESS_TOKEN=your_github_token_here

# === Configuration ===
# Nombre maximum d'itérations pour l'auto-correction
MAX_DEBUG_ITERATIONS=3

# Activer le déploiement automatique par défaut
AUTO_DEPLOY_DEFAULT=false
